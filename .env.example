# Copiar a .env (ignorado por git) y completar. Este archivo no contiene credenciales.
# POSTGRES_PASSWORD es obligatoria: Compose se niega a arrancar si está vacía.
POSTGRES_DB=evallab
POSTGRES_USER=evallab
POSTGRES_PASSWORD=
# Puerto publicado en 127.0.0.1 para desarrollo local fuera de Docker.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

API_PORT=8000

# Aislamiento del worker: únicos valores admitidos hasta implementar sandbox (M2) y
# gateway de modelo (M6). Otros valores abortan el arranque.
WORKER_AGENT_NETWORK=deny
WORKER_AGENT_HOST_TOOLS=false

# OpenTelemetry (opcional). Vacío = desactivado. Con `docker compose --profile otel up`:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# Proveedor de modelo live (opcional, DESACTIVADO por defecto). Ningún test ni comando del
# repositorio lo necesita: los patrones con modelo usan el proveedor `fixture` sin red. Lo usan
# sólo `evallab-benchmark run-live` y `evallab-judge-calibration votes` (docs/live-run.md).
# El worker de Compose no tiene salida a Internet: ejecutar desde el host.
#
# a) Local y gratuito (Ollama, compatible con OpenAI; no valida la clave):
# MODEL_GATEWAY_LIVE_ENABLED=true
# MODEL_GATEWAY_BASE_URL=http://127.0.0.1:11434/v1
# MODEL_GATEWAY_API_KEY=ollama-local-no-auth
# MODEL_GATEWAY_TIMEOUT_S=300
#
# b) Proveedor de pago (genera coste; usar --price-* y --max-cost-usd):
# MODEL_GATEWAY_LIVE_ENABLED=true
# MODEL_GATEWAY_BASE_URL=https://<proveedor>/v1
# MODEL_GATEWAY_API_KEY=   # clave real sólo en .env, nunca en este archivo
MODEL_GATEWAY_LIVE_ENABLED=false

# Demo de sólo lectura (opcional). EVALLAB_READ_ONLY=1 rechaza toda escritura;
# EVALLAB_ADMIN_TOKEN (>= 24 caracteres) exige Authorization: Bearer en escrituras y oráculos.
EVALLAB_READ_ONLY=0
EVALLAB_ADMIN_TOKEN=
