# Copiar a .env (ignorado por git) y completar. Este archivo no contiene credenciales.
# POSTGRES_PASSWORD es obligatoria: Compose se niega a arrancar si está vacía.
POSTGRES_DB=evallab
POSTGRES_USER=evallab
POSTGRES_PASSWORD=
# Puerto publicado en 127.0.0.1 para desarrollo local fuera de Docker.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

API_PORT=8000

# Aislamiento del worker: únicos valores admitidos hasta implementar sandbox (M2) y
# gateway de modelo (M6). Otros valores abortan el arranque.
WORKER_AGENT_NETWORK=deny
WORKER_AGENT_HOST_TOOLS=false

# OpenTelemetry (opcional). Vacío = desactivado. Con `docker compose --profile otel up`:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# Proveedor de modelo live (opcional, DESACTIVADO por defecto). Ningún test ni comando del
# repositorio lo necesita: los patrones con modelo usan el proveedor `fixture` sin red. Activarlo
# genera llamadas de pago; el worker de Compose además no tiene salida a Internet.
# MODEL_GATEWAY_LIVE_ENABLED=false
# MODEL_GATEWAY_BASE_URL=https://api.example.com/v1
# MODEL_GATEWAY_API_KEY=   # nunca en este archivo de ejemplo
